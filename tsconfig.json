{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "api",
    "outDir": "dist"
  },
  "include": ["api/**/*"],
  "exclude": ["node_modules", "dist"]
}
