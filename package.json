{
  "name": "@chassis-ui/mcp",
  "version": "0.1.5",
  "description": "Chassis UI MCP server — skills and prompts for AI agents working with the Chassis design system",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Chassis UI",
    "url": "https://www.chassis-ui.com"
  },
  "homepage": "https://github.com/chassis-ui/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/mcp.git"
  },
  "keywords": [
    "chassis-ui",
    "chassis",
    "figma",
    "design",
    "mcp",
    "ui"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "scripts": {
    "prepare": "node build/generate-content.js",
    "generate": "node build/generate-css-classes.js && node build/generate-content.js",
    "generate:css-classes": "node build/generate-css-classes.js",
    "build": "node build/generate-content.js && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "tsx --watch server/dev.ts",
    "inspect": "npx @modelcontextprotocol/inspector http://localhost:${PORT:-3000}/mcp",
    "lint": "eslint .",
    "lint:prettier": "prettier -c --cache .",
    "format": "prettier --write .",
    "check:pnpm": "pnpm audit --prod --audit-level moderate",
    "change-version": "node build/change-version.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@chassis-ui/css": "0.7.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
