{
  "name": "@chassis-ui/mcp",
  "version": "0.1.5",
  "description": "Chassis UI MCP server — skills and prompts for AI agents working with the Chassis design system",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Chassis UI",
    "url": "https://www.chassis-ui.com"
  },
  "homepage": "https://github.com/chassis-ui/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/mcp.git"
  },
  "keywords": [
    "chassis-ui",
    "chassis",
    "figma",
    "design",
    "mcp",
    "ui"
  ],
  "scripts": {
    "generate": "node build/generate-css-classes.js && node build/generate-content.js",
    "build": "node build/generate-content.js && tsc --noEmit",
    "dev": "tsx --watch server/dev.ts",
    "inspect": "npx @modelcontextprotocol/inspector http://localhost:3000/mcp",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "change-version": "node build/change-version.js",
    "generate:css-classes": "node build/generate-css-classes.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@chassis-ui/css": "0.7.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
