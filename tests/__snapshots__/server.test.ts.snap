// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`server > gives instructions 1`] = `
"Chassis UI is a design system: a Figma library (components in \`cx.components.UI\`, variables and styles in \`cx.tokens.MAIN\`) and the CSS framework \`@chassis-ui/css\`. This server serves its skills: how Chassis work is done, on top of the Figma MCP server and its skills, not in place of them.
- Before you build or update a Figma screen, page or view with the Chassis UI library, or in a Figma file that uses it, call \`chassis_create_design\`, before the first \`use_figma\` call, and follow what it returns.
- Before you write markup from a Figma design made with the Chassis UI library, call \`chassis_implement_design\` and follow what it returns. Check the classes you wrote with \`chassis_check_classes\`.
- To add a brand to a Chassis token repository and asset repository, call \`chassis_add_brand\`.
- Each of these tools returns the instructions of its skill and an index of its reference files. When the instructions send you to a reference, fetch it, or the section they link, with \`chassis_get_reference\`."
`;

exports[`server > lists its prompts 1`] = `
[
  {
    "arguments": undefined,
    "description": "One-shot Chassis Figma design build or reconnect",
    "name": "chassis-ui",
  },
  {
    "arguments": undefined,
    "description": "Load the chassis-create-design skill: build or update Figma screens using the Chassis UI library.",
    "name": "chassis-create-design",
  },
  {
    "arguments": undefined,
    "description": "Load the chassis-implement-design skill: implement Figma designs into code using Chassis UI CSS.",
    "name": "chassis-implement-design",
  },
  {
    "arguments": undefined,
    "description": "Load the chassis-add-brand skill: add a brand to a Chassis token repository and a Chassis asset repository.",
    "name": "chassis-add-brand",
  },
]
`;

exports[`server > lists its resources 1`] = `
[
  {
    "description": "Add a brand to a repository of design tokens built with \`@chassis-ui/tokens\` and to a repository of assets built with \`@chassis-ui/assets\`: the token set of the brand (palette, font families and weights, border radius), its option in \`$themes.json\`, its name in \`chassis.build\`, and then its fonts, logos, favicons, web manifest and app icon bundles under \`source/<brand>/\`, named and placed as the builds and the other brands expect. Use when the user wants to add, create or set up a brand, a white-label or a tenant in a Chassis token or asset repository, or to give an existing brand the fonts of a new family. Runs on files and commands, with no Figma tool: the export of the new brand to Figma is handed to the designer. Do NOT use for: a token value that is not a brand token (edit it in Tokens Studio or Figma), a change to the builders themselves (\`chassis-ui/tokens\`, \`chassis-ui/assets\`), a new app, theme or screen, building Figma screens (\`chassis-create-design\`) or writing markup (\`chassis-implement-design\`).",
    "mimeType": "text/markdown",
    "name": "chassis-add-brand",
    "uri": "chassis://skills/chassis-add-brand",
  },
  {
    "description": "The fonts of a brand",
    "mimeType": "text/markdown",
    "name": "chassis-add-brand/references/fonts",
    "uri": "chassis://skills/chassis-add-brand/references/fonts",
  },
  {
    "description": "The images, the app icon and the configuration of a brand",
    "mimeType": "text/markdown",
    "name": "chassis-add-brand/references/images",
    "uri": "chassis://skills/chassis-add-brand/references/images",
  },
  {
    "description": "The tokens of a brand",
    "mimeType": "text/markdown",
    "name": "chassis-add-brand/references/tokens",
    "uri": "chassis://skills/chassis-add-brand/references/tokens",
  },
  {
    "description": "Build or update a Figma design (screen, page, modal, dialog, drawer, panel, dashboard, landing page or any multi-section view) from the Chassis UI Figma library: instances of \`cx.components.UI\`, bound to the variables and styles of \`cx.tokens.MAIN\`. Use when the user wants to create, compose, assemble or reconnect a Figma view from code, a screenshot, a description or an existing detached layout. Runs on top of the Figma MCP server skills \`figma-use\` and \`figma-generate-design\` and adds how the Chassis library is found, read and composed at run time: component names, props and their defaults, text Assets, slots, text styles, tokens and modes. Do NOT use for: a fix inside a single component, generating code FROM Figma (use \`chassis-implement-design\`), token and variable edits, or adding a brand to the token and asset repositories (use \`chassis-add-brand\`).",
    "mimeType": "text/markdown",
    "name": "chassis-create-design",
    "uri": "chassis://skills/chassis-create-design",
  },
  {
    "description": "The Chassis UI library in Figma",
    "mimeType": "text/markdown",
    "name": "chassis-create-design/references/components",
    "uri": "chassis://skills/chassis-create-design/references/components",
  },
  {
    "description": "Plugin API recipes for the Chassis library",
    "mimeType": "text/markdown",
    "name": "chassis-create-design/references/recipes",
    "uri": "chassis://skills/chassis-create-design/references/recipes",
  },
  {
    "description": "Chassis tokens in Figma",
    "mimeType": "text/markdown",
    "name": "chassis-create-design/references/tokens",
    "uri": "chassis://skills/chassis-create-design/references/tokens",
  },
  {
    "description": "Chassis build and reconnect workflow",
    "mimeType": "text/markdown",
    "name": "chassis-create-design/references/workflow",
    "uri": "chassis://skills/chassis-create-design/references/workflow",
  },
  {
    "description": "Implement a Figma design made with the Chassis UI Figma library as production HTML using Chassis CSS (\`@chassis-ui/css\` 0.11), in a native CSS project or a Tailwind CSS v4 project that uses the Chassis Tailwind entry. Use when the user wants to translate, generate, build, or convert a Chassis Figma view, screen, page, modal, drawer, panel, dashboard, landing page, or component into shipping markup with 1:1 visual fidelity. Runs on top of the Figma MCP server skill \`figma-design-to-code\` and adds the Chassis class catalog, the Figma-token-to-class translation, Asset text extraction, component markup, and theming. Do NOT use for: writing INTO Figma (use \`chassis-create-design\`), React components, token/SCSS edits, adding a brand to the token and asset repositories (use \`chassis-add-brand\`), or non-Chassis design systems.",
    "mimeType": "text/markdown",
    "name": "chassis-implement-design",
    "uri": "chassis://skills/chassis-implement-design",
  },
  {
    "description": "Components — Figma component → Chassis CSS markup",
    "mimeType": "text/markdown",
    "name": "chassis-implement-design/references/components",
    "uri": "chassis://skills/chassis-implement-design/references/components",
  },
  {
    "description": "Chassis CSS Class Catalog",
    "mimeType": "text/markdown",
    "name": "chassis-implement-design/references/css-classes",
    "uri": "chassis://skills/chassis-implement-design/references/css-classes",
  },
  {
    "description": "Chassis Implementation Patterns",
    "mimeType": "text/markdown",
    "name": "chassis-implement-design/references/patterns",
    "uri": "chassis://skills/chassis-implement-design/references/patterns",
  },
  {
    "description": "Token Translation — Figma variables → Chassis CSS classes",
    "mimeType": "text/markdown",
    "name": "chassis-implement-design/references/tokens",
    "uri": "chassis://skills/chassis-implement-design/references/tokens",
  },
  {
    "description": "Chassis Implement Workflow",
    "mimeType": "text/markdown",
    "name": "chassis-implement-design/references/workflow",
    "uri": "chassis://skills/chassis-implement-design/references/workflow",
  },
]
`;

exports[`server > lists its tools 1`] = `
[
  {
    "description": "Load the chassis-create-design skill: build or update Figma screens using the Chassis UI library. Returns the skill instructions and an index of its reference files and their sections, which are fetched on demand with chassis_get_reference.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "full": {
          "description": "Also return every reference file of the skill, inline after the instructions, instead of the index of their names: several times the size. Default false",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "chassis_create_design",
  },
  {
    "description": "Load the chassis-implement-design skill: implement Figma designs into production code using Chassis UI CSS. Returns the skill instructions and an index of its reference files and their sections, which are fetched on demand with chassis_get_reference.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "full": {
          "description": "Also return every reference file of the skill, inline after the instructions, instead of the index of their names: several times the size. Default false",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "chassis_implement_design",
  },
  {
    "description": "Load the chassis-add-brand skill: add a brand to a repository of tokens built with @chassis-ui/tokens and a repository of assets built with @chassis-ui/assets, its token set, option and fonts, images and app icon. Returns the skill instructions and an index of its reference files and their sections, which are fetched on demand with chassis_get_reference.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "full": {
          "description": "Also return every reference file of the skill, inline after the instructions, instead of the index of their names: several times the size. Default false",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "chassis_add_brand",
  },
  {
    "description": "Fetch one reference file of a Chassis UI skill by name, without its frontmatter, or one section of it, or several sections in one call. The skill tools list the names, what each file holds and its sections.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "name": {
          "description": "Reference file to fetch",
          "enum": [
            "chassis-add-brand/references/fonts",
            "chassis-add-brand/references/images",
            "chassis-add-brand/references/tokens",
            "chassis-create-design/references/components",
            "chassis-create-design/references/recipes",
            "chassis-create-design/references/tokens",
            "chassis-create-design/references/workflow",
            "chassis-implement-design/references/components",
            "chassis-implement-design/references/css-classes",
            "chassis-implement-design/references/patterns",
            "chassis-implement-design/references/tokens",
            "chassis-implement-design/references/workflow",
          ],
          "type": "string",
        },
        "section": {
          "description": "A heading of the file, or the anchor of a link \`file.md#anchor\`: returns that section, with its subsections and the introduction of the file, instead of the whole file. The skill tools list the sections of each file",
          "type": "string",
        },
        "sections": {
          "description": "Several sections of the file in one call, each a heading or an anchor as for \`section\`: returns them in the order of the file, under one introduction. Use it when a step needs more than one section of the same file",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "chassis_get_reference",
  },
  {
    "description": "Check class names against the Chassis CSS class catalog (css-classes.md of chassis-implement-design): returns the classes that do not exist in the given CSS mode, each with why and the catalog section to read, or one line when all exist. Pass class names, class attribute values or markup.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "classes": {
          "description": "Class names to check: one per item, or space-separated as in a class attribute, or markup, whose \`class\` attributes are read",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "mode": {
          "description": "The CSS mode of the project: \`native\` (the compiled stylesheet, where a class takes the variant prefixes listed for its family) or \`tailwind\` (the Chassis Tailwind entry, where every Tailwind variant applies to a Chassis utility). Default native",
          "enum": [
            "native",
            "tailwind",
          ],
          "type": "string",
        },
      },
      "required": [
        "classes",
      ],
      "type": "object",
    },
    "name": "chassis_check_classes",
  },
]
`;
